datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum PartOfSpeech {
  Noun
  Verb
  Adjective
  Adverb
  Phrase
  Other
}

enum CourseLevel {
  Beginner
  Intermediate
  Advanced
}

enum Role {
  user
  admin
}

model User {
  uid       String   @id @db.VarChar(255)
  name      String   @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  role      Role     @default(user)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  topics             Topic[]
  vocabularies       Vocabulary[]
  lessonProgresses   LessonProgress[]
  vocabProgresses    VocabularyProgress[]
  shadowingVideos    ShadowingVideo[]
  courseAccesses     CourseAccess[]
  topicProgresses    TopicProgress[]
  shadowingProgresses ShadowingProgress[]
  courseReviews      CourseReview[]
  dictationAttempts  DictationAttempt[]
  dictationTopicProgresses DictationTopicProgress[]
  todoLists          TodoList[]
  todoCompletions    TodoCompletion[]
  pomodoroSessions   PomodoroSession[]
  sentencePractices  UserSentencePractice[]

  @@map("users")
}

model Topic {
  id              String   @id @db.VarChar(255)
  name            String   @db.VarChar(255)
  description     String?  @db.Text
  createdByUserId String?  @map("created_by_user") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp()

  createdByUser    User?    @relation(fields: [createdByUserId], references: [uid], onDelete: SetNull)
  vocabularies     Vocabulary[]
  topicProgresses  TopicProgress[]

  @@map("topics")
}

model Vocabulary {
  id              String       @id @db.VarChar(255)
  topicId         String       @map("topic_id") @db.VarChar(255)
  word            String       @db.VarChar(255)
  meaning         String       @db.Text
  definition      String?      @db.Text
  example         String?      @db.Text
  category        String       @db.VarChar(255)
  partOfSpeech    PartOfSpeech @map("part_of_speech")
  pronunciation   String?      @db.VarChar(255)
  imageUrl        String?      @map("image_url") @db.Text
  createdByUserId String?      @map("created_by_user") @db.VarChar(255)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamp()

  topic            Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  createdByUser    User?        @relation(fields: [createdByUserId], references: [uid], onDelete: SetNull)
  vocabProgresses  VocabularyProgress[]
  sentencePractices UserSentencePractice[]

  @@map("vocabulary")
}

model Course {
  id            String        @id @db.VarChar(255)
  title         String        @db.VarChar(255)
  description   String        @db.Text
  thumbnail     String        @db.Text
  level         CourseLevel
  subject       String?       @db.VarChar(255)
  accessCode    String?       @map("access_code") @db.VarChar(100)
  rating        Float?        @default(4.8)
  weeks         Int?          @default(8)
  price         Int?          @default(0)
  originalPrice Int?          @map("original_price")
  isBestSeller  Boolean       @default(false) @map("is_best_seller")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamp()

  lessons       Lesson[]
  topics        CourseTopic[]
  accesses      CourseAccess[]
  reviews       CourseReview[]
  objectives    String?       @db.Text
  info          String?       @db.Text
  todoLists     TodoList[]

  @@map("courses")
}

model CourseAccess {
  id          String   @id @db.VarChar(255)
  userId      String   @map("user_id") @db.VarChar(255)
  courseId    String   @map("course_id") @db.VarChar(255)
  redeemedAt  DateTime @default(now()) @map("redeemed_at") @db.Timestamp()

  user        User     @relation(fields: [userId], references: [uid], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId], name: "uniqueUserCourseAccess")
  @@map("course_access")
}

model CourseTopic {
  id          String   @id @db.VarChar(255)
  courseId    String   @map("course_id") @db.VarChar(255)
  title       String   @db.VarChar(255)
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp()

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@map("course_topics")
}

model Lesson {
  id              String   @id @db.VarChar(255)
  courseId        String   @map("course_id") @db.VarChar(255)
  topicId         String?  @map("topic_id") @db.VarChar(255)
  title           String   @db.VarChar(255)
  duration        String   @db.VarChar(20)
  videoUrl        String   @map("video_url") @db.Text
  description     String?  @db.Text
  practiceContent String?  @map("practice_content") @db.Text
  order           Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp()

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseTopic CourseTopic? @relation(fields: [topicId], references: [id], onDelete: Cascade)
  progresses  LessonProgress[]
  questions   Question[]

  @@map("lessons")
}

model Question {
  id           String   @id @default(uuid()) @db.VarChar(255)
  lessonId     String   @map("lesson_id") @db.VarChar(255)
  content      String   @db.Text
  explanation  String?  @db.Text
  questionType String   @default("multiple_choice") @map("question_type") @db.VarChar(50)
  difficulty   String?  @default("medium") @db.VarChar(50)
  category     String?  @db.VarChar(100)
  orderIndex   Int      @default(0) @map("order_index")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  lesson       Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  options      QuestionOption[]

  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(uuid()) @db.VarChar(255)
  questionId String   @map("question_id") @db.VarChar(255)
  key        String   @db.VarChar(10)
  content    String   @db.Text
  isCorrect  Boolean  @default(false) @map("is_correct")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp()

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_options")
}

model ShadowingVideo {
  id              String   @id @db.VarChar(255)
  title           String   @db.VarChar(255)
  description     String?  @db.Text
  videoUrl        String   @map("video_url") @db.Text
  transcript      String   @db.Text
  createdByUserId String?  @map("created_by_user") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp()

  createdByUser    User?    @relation(fields: [createdByUserId], references: [uid], onDelete: SetNull)
  progresses       ShadowingProgress[]

  @@map("shadowing_videos")
}

model LessonProgress {
  id                String   @id @db.VarChar(255)
  userId            String   @map("user_id") @db.VarChar(255)
  lessonId          String   @map("lesson_id") @db.VarChar(255)
  videoCompleted    Boolean  @default(true) @map("video_completed")
  practiceCompleted Boolean  @default(false) @map("practice_completed")
  completedAt       DateTime @default(now()) @map("completed_at") @db.Timestamp()

  user        User     @relation(fields: [userId], references: [uid], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId], name: "uniqueUserLessonProgress")
  @@map("lesson_progress")
}

model VocabularyProgress {
  id             String    @id @db.VarChar(255)
  userId         String    @map("user_id") @db.VarChar(255)
  vocabularyId   String    @map("vocabulary_id") @db.VarChar(255)
  
  // SRS SM-2 fields
  status         String    @default("learning") @db.VarChar(50) // "learning" | "reviewing" | "mastered"
  interval       Int       @default(0) // Interval in days
  easeFactor     Float     @default(2.5) @map("ease_factor")
  repetitions    Int       @default(0)
  nextReviewAt   DateTime  @default(now()) @map("next_review_at") @db.Timestamp()
  lastReviewedAt DateTime? @map("last_reviewed_at") @db.Timestamp()
  reviewCount    Int       @default(0) @map("review_count")
  lapseCount     Int       @default(0) @map("lapse_count")
  masteredAt     DateTime? @map("mastered_at") @db.Timestamp()

  user           User       @relation(fields: [userId], references: [uid], onDelete: Cascade)
  vocabulary     Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  reviewLogs     SrsReviewLog[]

  @@unique([userId, vocabularyId], name: "uniqueUserVocabularyProgress")
  @@index([userId, nextReviewAt])
  @@map("vocabulary_progress")
}

model SrsReviewLog {
  id             String    @id @default(uuid()) @db.VarChar(255)
  userId         String    @map("user_id") @db.VarChar(255)
  progressId     String    @map("progress_id") @db.VarChar(255)
  rating         String    @db.VarChar(20) // "again" | "hard" | "good" | "easy"
  intervalBefore Int       @map("interval_before")
  intervalAfter  Int       @map("interval_after")
  easeFactor     Float     @default(2.5) @map("ease_factor")
  reviewedAt     DateTime  @default(now()) @map("reviewed_at") @db.Timestamp()

  progress       VocabularyProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  @@map("srs_review_logs")
}

model TopicProgress {
  id          String   @id @db.VarChar(255)
  userId      String   @map("user_id") @db.VarChar(255)
  topicId     String   @map("topic_id") @db.VarChar(255)
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamp()

  user        User     @relation(fields: [userId], references: [uid], onDelete: Cascade)
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId], name: "uniqueUserTopicProgress")
  @@map("topic_progress")
}

model ShadowingProgress {
  id          String   @id @db.VarChar(255)
  userId      String   @map("user_id") @db.VarChar(255)
  videoId     String   @map("video_id") @db.VarChar(255)
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamp()

  user        User           @relation(fields: [userId], references: [uid], onDelete: Cascade)
  video       ShadowingVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId], name: "uniqueUserShadowingProgress")
  @@map("shadowing_progress")
}

model CourseReview {
  id        String   @id @db.VarChar(255)
  courseId  String   @map("course_id") @db.VarChar(255)
  userId    String   @map("user_id") @db.VarChar(255)
  rating    Int
  comment   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp()

  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@map("course_reviews")
}

model DictationTopic {
  id          String   @id @default(uuid()) @db.VarChar(255)
  title       String   @db.VarChar(255)
  description String?  @db.Text
  thumbnail   String?  @db.Text
  level       String   @db.VarChar(50)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  sentences   DictationSentence[]
  progresses  DictationTopicProgress[]

  @@map("dictation_topics")
}

model DictationSentence {
  id          String   @id @default(uuid()) @db.VarChar(255)
  topicId     String   @map("topic_id") @db.VarChar(255)
  audioUrl    String   @map("audio_url") @db.Text
  transcript  String   @db.Text
  duration    Int      @default(0)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  topic       DictationTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  attempts    DictationAttempt[]

  @@map("dictation_sentences")
}

model DictationAttempt {
  id           String   @id @default(uuid()) @db.VarChar(255)
  userId       String   @map("user_id") @db.VarChar(255)
  sentenceId   String   @map("sentence_id") @db.VarChar(255)
  answer       String   @db.Text
  accuracy     Float
  correctWords Int      @default(0) @map("correct_words")
  wrongWords   Int      @default(0) @map("wrong_words")
  missingWords Int      @default(0) @map("missing_words")
  extraWords   Int      @default(0) @map("extra_words")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp()

  user         User              @relation(fields: [userId], references: [uid], onDelete: Cascade)
  sentence     DictationSentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)

  @@map("dictation_attempts")
}

model DictationTopicProgress {
  id          String   @id @default(uuid()) @db.VarChar(255)
  userId      String   @map("user_id") @db.VarChar(255)
  topicId     String   @map("topic_id") @db.VarChar(255)
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamp()

  user        User           @relation(fields: [userId], references: [uid], onDelete: Cascade)
  topic       DictationTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId], name: "uniqueUserDictationTopicProgress")
  @@map("dictation_topic_progress")
}

model TodoList {
  id        String     @id @default(uuid()) @db.VarChar(255)
  userId    String     @map("user_id") @db.VarChar(255)
  courseId  String?    @map("course_id") @db.VarChar(255)
  title     String     @db.VarChar(255)
  frequency String     @default("daily") @db.VarChar(50)
  order     Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamp()
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  user      User       @relation(fields: [userId], references: [uid], onDelete: Cascade)
  course    Course?    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tasks     TodoTask[]

  @@map("todo_lists")
}

model TodoTask {
  id         String          @id @default(uuid()) @db.VarChar(255)
  todoListId String          @map("todo_list_id") @db.VarChar(255)
  content    String          @db.Text
  order      Int             @default(0)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamp()

  todoList    TodoList        @relation(fields: [todoListId], references: [id], onDelete: Cascade)
  completions TodoCompletion[]

  @@map("todo_tasks")
}

model TodoCompletion {
  id          String   @id @default(uuid()) @db.VarChar(255)
  userId      String   @map("user_id") @db.VarChar(255)
  taskId      String   @map("task_id") @db.VarChar(255)
  date        String   @db.VarChar(10)
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamp()

  user        User     @relation(fields: [userId], references: [uid], onDelete: Cascade)
  task        TodoTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId, date], name: "uniqueUserTaskDate")
  @@map("todo_completions")
}

model PomodoroSession {
  id          String   @id @default(uuid()) @db.VarChar(255)
  userId      String   @map("user_id") @db.VarChar(255)
  duration    Int      // seconds actually focused
  type        String   @default("work") @db.VarChar(20) // "work" | "break"
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamp()

  user        User     @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@map("pomodoro_sessions")
}

model UserSentencePractice {
  id                       String   @id @default(uuid()) @db.VarChar(255)
  userId                   String   @map("user_id") @db.VarChar(255)
  vocabularyId             String   @map("vocabulary_id") @db.VarChar(255)
  userSentence             String   @map("user_sentence") @db.Text
  isCorrect                Boolean  @default(false) @map("is_correct")
  score                    Int      @default(0)
  targetWordUsed           Boolean  @default(true) @map("target_word_used")
  feedback                 String   @db.Text
  grammarErrors            String[] @map("grammar_errors")
  suggestedSentence        String   @map("suggested_sentence") @db.Text
  suggestedSentenceMeaning String   @map("suggested_sentence_meaning") @db.Text
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  user                     User       @relation(fields: [userId], references: [uid], onDelete: Cascade)
  vocabulary               Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabularyId], name: "uniqueUserVocabSentencePractice")
  @@map("user_sentence_practices")
}
